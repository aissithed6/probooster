  function formatCurrency(
    value: number,
    currencyOverride?: 'xof' | 'usd' | 'eur' | 'XOF' | 'USD' | 'EUR'
  ) {
    const currencyMap = {
      xof: 'XOF',
      usd: 'USD',
      eur: 'EUR',
    } as const

    const normalizedCurrency = (currencyOverride ?? selectedCurrency).toLowerCase() as keyof typeof currencyMap

    const amount = normalizedCurrency === 'xof'
      ? value
      : normalizedCurrency === 'usd'
        ? value / 600
        : value / 650

    return new Intl.NumberFormat('fr-FR', {
      style: 'currency',
      currency: currencyMap[normalizedCurrency],
      maximumFractionDigits: normalizedCurrency === 'xof' ? 0 : 2,
    }).format(amount)
  }

