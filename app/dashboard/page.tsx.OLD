  // Fonction pour gÃ©rer le retrait de points
  const handleWithdrawal = () => {
    if (!withdrawalAmount || !selectedWithdrawalMethod) {
      toast({
        title: "Informations manquantes",
        description: "Veuillez indiquer un montant valide et choisir un mode de retrait",
        variant: "destructive",
      })
      return
    }

    const parsedAmount = Number.parseInt(withdrawalAmount, 10)
    if (!Number.isFinite(parsedAmount) || parsedAmount <= 0) {
      toast({
        title: "Montant invalide",
        description: "Le nombre de points doit Ãªtre positif",
        variant: "destructive",
      })
      return
    }

    if (parsedAmount < minWithdrawalPoints) {
      toast({
        title: "Montant insuffisant",
        description: `Le minimum autorisÃ© est de ${minWithdrawalPoints.toLocaleString()} points`,
        variant: "destructive",
      })
      return
    }

    if (maxWithdrawalPoints > 0 && parsedAmount > maxWithdrawalPoints) {
      toast({
        title: "Montant trop Ã©levÃ©",
        description: `Le maximum autorisÃ© est de ${maxWithdrawalPoints.toLocaleString()} points`,
        variant: "destructive",
      })
      return
    }

    if (totalWithdrawalCost > userPoints) {
      toast({
        title: "Solde insuffisant",
        description: "Votre solde ne couvre pas le montant et les frais",
        variant: "destructive",
      })
      return
    }

    if (!withdrawalDetailsValid) {
      toast({
        title: "Informations incomplÃ¨tes",
        description:
          selectedWithdrawalMethod === 'mobile-money'
            ? 'Merci de renseigner un numÃ©ro Mobile Money valide (8 caractÃ¨res ou plus).'
            : 'Merci de renseigner une adresse PayPal valide.',
        variant: "destructive",
      })
      return
    }

    const methodLabel = selectedWithdrawalMethod === 'mobile-money' ? 'Mobile Money' : 'PayPal'
    toast({
      title: "Retrait en cours...",
      description: `Demande de retrait de ${parsedAmount.toLocaleString()} points (${formatCurrency(withdrawalGrossValue)}) via ${methodLabel}.`,
      variant: "default",
    })

    setTimeout(() => {
      toast({
        title: "Retrait confirmÃ© !",
        description: `Montant net envoyÃ©: ${withdrawalNetPoints.toLocaleString()} points (${formatCurrency(withdrawalNetValue)}). Frais: ${withdrawalFeePoints.toLocaleString()} pts (${withdrawalFeeLabel})`,
        variant: "default",
      })

      setUserPoints(prev => Math.max(0, prev - totalWithdrawalCost))
      setWithdrawalAmount('')
      setSelectedWithdrawalMethod(null)
      setWithdrawalMobileNumber('')
      setWithdrawalPaypalEmail('')
      setShowWithdrawalModal(false)
    }, 1500)
  }

