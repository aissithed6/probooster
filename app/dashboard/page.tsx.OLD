      <Dialog open={showExportModal} onOpenChange={setShowExportModal}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Exporter mes donnÃ©es</DialogTitle>
            <DialogDescription>
              TÃ©lÃ©chargez une copie de toutes vos donnÃ©es personnelles
            </DialogDescription>
