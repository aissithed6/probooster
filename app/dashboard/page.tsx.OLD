                    <Phone className="w-10 h-10 text-green-600" />
                  </div>
                  <h3 className="text-lg font-semibold text-gray-900 mb-2">{selectedChatSeller}</h3>
                  <p className="text-gray-600">Appel en cours...</p>
                  <div className="mt-6 space-y-3">
                    <Button 
                      className="w-full bg-red-600 hover:bg-red-700"
                      onClick={() => setShowCallModal(false)}
                    >
                      <Phone className="w-4 h-4 mr-2" />
                      Raccrocher
                    </Button>
                  </div>
                </div>
              </DialogContent>
            </Dialog>

            {/* Modal d'appel vidÃ©o */}
            <Dialog open={showVideoCallModal} onOpenChange={setShowVideoCallModal}>
              <DialogContent className="max-w-4xl">
                <DialogHeader>
                  <DialogTitle className="flex items-center space-x-2">
                    <Video className="w-5 h-5 text-blue-600" />
                    <span>Appel vidÃ©o en cours...</span>
                  </DialogTitle>
                  <DialogDescription>
                    Connexion vidÃ©o avec {selectedChatSeller}
                  </DialogDescription>
