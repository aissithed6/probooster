      quantity: 1,
      addedAt: new Date()
    }
    setProductCart(prev => [...prev, cartItem])

    // Afficher la modal de confirmation
    setSelectedProduct(product)
    setShowProductAddedModal(true)

    toast({
      title: "Produit ajoutÃ© au panier !",
      description: `${product.name} a Ã©tÃ© ajoutÃ© Ã  votre panier`,
      variant: "default",
    })
  }

  const addProductToCartWithPromotion = (product: any, promotion: any) => {
    // VÃ©rifier si le produit est dÃ©jÃ  dans le panier
    if (productCart.some(item => item.id === product.id)) {
      toast({
        title: "Produit dÃ©jÃ  dans le panier",
        description: "Ce produit est dÃ©jÃ  prÃ©sent dans votre panier",
        variant: "destructive",
      })
      return
    }

    // Ajouter au panier avec la promotion active
    const cartItem = {
      ...product,
      quantity: 1,
      addedAt: new Date(),
      activePromotion: promotion ? {
        code: promotion.code || promotion.id,
        title: promotion.title,
        value: promotion.value,
        type: promotion.type
      } : null
    }
    setProductCart(prev => [...prev, cartItem])

    // Afficher la modal de confirmation
    setSelectedProduct(product)
    setShowProductAddedModal(true)

    toast({
      title: "Produit ajoutÃ© avec promotion !",
      description: `${product.name} a Ã©tÃ© ajoutÃ© Ã  votre panier avec la promotion ${promotion?.title || 'active'}`,
      variant: "default",
