  // Fonction pour gÃ©nÃ©rer et tÃ©lÃ©charger l'historique des transactions en CSV
  const generateAndDownloadTransactionsCSV = () => {
    console.log('Fonction generateAndDownloadTransactionsCSV appelÃ©e !')
    try {
      // DonnÃ©es des transactions (mock)
      const transactions = [
        {
          id: '1',
          type: 'earned',
          amount: 200,
          description: 'Partage Facebook - iPhone 15 Pro Max',
          date: '2024-01-15T10:30:00Z',
          balance: 15420
        },
        {
          id: '2',
          type: 'used',
          amount: -500,
          description: 'Achat - Commande ORD-001',
          date: '2024-01-15T09:15:00Z',
          balance: 15220
        },
        {
          id: '3',
          type: 'earned',
          amount: 150,
          description: 'Partage WhatsApp - MacBook Air M2',
          date: '2024-01-14T16:45:00Z',
          balance: 15720
        },
        {
          id: '4',
          type: 'withdrawn',
          amount: -2000,
          description: 'Retrait vers compte bancaire',
          date: '2024-01-10T14:20:00Z',
          balance: 15570
        },
        {
          id: '5',
          type: 'earned',
          amount: 300,
          description: 'Partage Twitter - Samsung Galaxy S24',
          date: '2024-01-08T11:30:00Z',
          balance: 17570
        }
      ]

      // CrÃ©er le contenu CSV
      const csvContent = [
        // En-tÃªtes
        ['ID', 'Type', 'Montant (points)', 'Description', 'Date', 'Solde aprÃ¨s transaction'],
        // DonnÃ©es
        ...transactions.map(t => [
          t.id,
          t.type === 'earned' ? 'GagnÃ©' : t.type === 'used' ? 'UtilisÃ©' : 'RetirÃ©',
          t.amount > 0 ? `+${t.amount}` : t.amount.toString(),
          t.description,
          formatDate(t.date),
          t.balance.toLocaleString()
        ])
      ].map(row => row.join(',')).join('\n')

      // CrÃ©er un blob avec le contenu CSV
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' })
      
      // CrÃ©er un lien de tÃ©lÃ©chargement
      const url = window.URL.createObjectURL(blob)
      const link = document.createElement('a')
      link.href = url
      link.download = `Historique-Transactions-${new Date().toISOString().split('T')[0]}.csv`
      
      // DÃ©clencher le tÃ©lÃ©chargement
      document.body.appendChild(link)
      link.click()
      
      // Nettoyer
      document.body.removeChild(link)
      window.URL.revokeObjectURL(url)
      
      // Notification de succÃ¨s
      toast({
        title: "Historique exportÃ© !",
        description: "L'historique des transactions a Ã©tÃ© tÃ©lÃ©chargÃ© en CSV",
        variant: "default",
      })
      
      console.log('Export CSV rÃ©ussi ! Fichier tÃ©lÃ©chargÃ©.')
    } catch (error) {
      console.error('Erreur lors de l\'export CSV:', error)
      
      // Notification d'erreur
      toast({
