                          variant="outline" 
                          size="sm"
                          onClick={() => {
                            // Trier les messages par prioritÃ©
                            const priorityOrder = { high: 3, medium: 2, low: 1 }
                            const sortedMessages = [...clientMessages].sort((a, b) => 
                              priorityOrder[b.priority as keyof typeof priorityOrder] - priorityOrder[a.priority as keyof typeof priorityOrder]
                            )
                            
                            setClientMessages(sortedMessages)
                            
                            toast({
                              title: "Triage effectuÃ© !",
                              description: "Vos messages ont Ã©tÃ© triÃ©s par prioritÃ© (Haute â†’ Moyenne â†’ Basse)",
