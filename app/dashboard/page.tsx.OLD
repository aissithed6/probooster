  const [analyticsEnabled, setAnalyticsEnabled] = useState(true)
  const [personalizedRecommendations, setPersonalizedRecommendations] = useState(true)

  const [currentPassword, setCurrentPassword] = useState('')
  const [newPassword, setNewPassword] = useState('')
  const [confirmPassword, setConfirmPassword] = useState('')
  const [showCurrentPassword, setShowCurrentPassword] = useState(false)
  const [showNewPassword, setShowNewPassword] = useState(false)
  const [showConfirmPassword, setShowConfirmPassword] = useState(false)

  const [notificationSettings, setNotificationSettings] = useState({
    email: true,
    push: true,
    sms: false,
    orders: true,
    points: true,
    chat: true,
    promotions: true,
    system: false,
    ai: true
  })
  const [notificationFrequency, setNotificationFrequency] = useState('daily')
  const [notificationStartTime, setNotificationStartTime] = useState('08:00')
  const [notificationEndTime, setNotificationEndTime] = useState('22:00')
  const [showNotificationActions, setShowNotificationActions] = useState<Record<string, boolean>>({})
  const [showNotificationSettings, setShowNotificationSettings] = useState(false)

  const [productSearchQuery, setProductSearchQuery] = useState('')
  const [showChatModal, setShowChatModal] = useState(false)
  const [showGlobalChatModal, setShowGlobalChatModal] = useState(false)
  const [showShopModal, setShowShopModal] = useState(false)
  const [selectedChatSeller, setSelectedChatSeller] = useState<string | null>(null)
  const [selectedShopSeller, setSelectedShopSeller] = useState<string | null>(null)
  const [showCartModal, setShowCartModal] = useState(false)

  const messagesEndRef = useRef<HTMLDivElement>(null)
  const fileInputRef = useRef<HTMLInputElement>(null)

  // Ã‰tat pour le menu de partage
  const [showShareMenu, setShowShareMenu] = useState(false)
  const [openProductShareMenu, setOpenProductShareMenu] = useState<string | null>(null)
  const [showProductDetailsModal, setShowProductDetailsModal] = useState(false)
  const [selectedProductForDetails, setSelectedProductForDetails] = useState<any>(null)
  const [showPointsExchangeModal, setShowPointsExchangeModal] = useState(false)
  const [exchangePointsAmount, setExchangePointsAmount] = useState('')
  const [exchangeCurrency, setExchangeCurrency] = useState<'XOF' | 'USD' | 'EUR'>('XOF')
  const [exchangePointsValue, setExchangePointsValue] = useState(0)
  const [transferPointsValue, setTransferPointsValue] = useState(0)
  const [withdrawalPointsValue, setWithdrawalPointsValue] = useState(0)

  // Hooks localStorage
  const { value: cartItems } = useLocalStorageArray<CartItem>('cart', [])
  const { value: userPoints, setValue: setUserPoints } = useLocalStorageNumber('userPoints', PointsService.getUserPoints())
  const { pointSettings: dashboardPointSettings } = usePointSettingsDashboardData()
  const pointSettings = dashboardPointSettings
  const pointValue = pointSettings?.pointValue ?? DEFAULT_ADMIN_POINT_SETTINGS.pointValue
  const purchaseValue = pointSettings?.purchaseValue ?? DEFAULT_ADMIN_POINT_SETTINGS.purchaseValue
  const withdrawalValue = pointSettings?.withdrawalValue ?? DEFAULT_ADMIN_POINT_SETTINGS.withdrawalValue
  const transferFeeConfig = pointSettings?.fees?.transfer ?? {
    flat: pointSettings?.transferFees ?? DEFAULT_ADMIN_POINT_SETTINGS.transferFees,
    percentage: 0,
  }
  const exchangeFeeConfig = pointSettings?.fees?.exchange ?? {
    flat: pointSettings?.exchangeFee ?? DEFAULT_ADMIN_POINT_SETTINGS.exchangeFee,
    percentage: 0,
  }
  const withdrawalFeeConfig = pointSettings?.fees?.withdrawal ?? {
    flat: DEFAULT_ADMIN_POINT_SETTINGS.fees.withdrawal.flat,
    percentage: DEFAULT_ADMIN_POINT_SETTINGS.fees.withdrawal.percentage,
  }
  const minWithdrawalPoints = pointSettings?.minWithdrawal ?? DEFAULT_ADMIN_POINT_SETTINGS.minWithdrawal
  const maxWithdrawalPoints = pointSettings?.maxWithdrawal ?? DEFAULT_ADMIN_POINT_SETTINGS.maxWithdrawal
  const socialSharePerNetwork = pointSettings?.socialSharePerNetwork ?? DEFAULT_ADMIN_POINT_SETTINGS.socialSharePerNetwork
  const basePointsPerFCFA = pointSettings?.basePointsPerFCFA ?? DEFAULT_ADMIN_POINT_SETTINGS.basePointsPerFCFA
  const premiumVendorBonus = pointSettings?.premiumVendorBonus ?? DEFAULT_ADMIN_POINT_SETTINGS.premiumVendorBonus
  const referralBonus = pointSettings?.referralBonus ?? DEFAULT_ADMIN_POINT_SETTINGS.referralBonus
  const firstPurchaseBonus = pointSettings?.firstPurchaseBonus ?? DEFAULT_ADMIN_POINT_SETTINGS.firstPurchaseBonus
  const weekendBonus = pointSettings?.weekendBonus ?? DEFAULT_ADMIN_POINT_SETTINGS.weekendBonus
  const bulkPurchaseBonus = pointSettings?.bulkPurchaseBonus ?? DEFAULT_ADMIN_POINT_SETTINGS.bulkPurchaseBonus
  const bulkPurchaseThreshold = pointSettings?.bulkPurchaseThreshold ?? DEFAULT_ADMIN_POINT_SETTINGS.bulkPurchaseThreshold
  const currencyPerPoint = 1 / pointValue
  const pointsConversionRates: Record<'XOF' | 'USD' | 'EUR', number> = {
    XOF: currencyPerPoint,
    USD: currencyPerPoint * 0.0016,
    EUR: currencyPerPoint * 0.0015,
  }

  const calculateFeePoints = (amount: number, fee: { flat: number; percentage: number | undefined }) => {
    if (!Number.isFinite(amount) || amount <= 0) {
      return 0
    }
    const percentagePortion = fee.percentage ? (amount * fee.percentage) / 100 : 0
    const raw = fee.flat + percentagePortion
    return Math.max(0, Math.ceil(raw))
  }

  const formatFeeLabel = (fee: { flat: number; percentage?: number }) => {
    const parts: string[] = []
    if (fee.percentage && fee.percentage > 0) {
      parts.push(`${fee.percentage}%`)
    }
    if (fee.flat && fee.flat > 0) {
      parts.push(`${fee.flat.toLocaleString()} pts`)
    }
    if (!parts.length) {
      return "Aucun frais"
    }
    return parts.join(' + ')
  }

  const exchangeFeePoints = calculateFeePoints(exchangePointsValue, {
    flat: exchangeFeeConfig.flat,
    percentage: exchangeFeeConfig.percentage ?? 0,
  })
  const transferFeePoints = calculateFeePoints(transferPointsValue, {
    flat: transferFeeConfig.flat,
    percentage: transferFeeConfig.percentage ?? 0,
  })
  const withdrawalFeePoints = calculateFeePoints(withdrawalPointsValue, {
    flat: withdrawalFeeConfig.flat,
    percentage: withdrawalFeeConfig.percentage ?? 0,
  })
  const totalExchangeCost = exchangePointsValue + exchangeFeePoints
  const totalTransferCost = transferPointsValue + transferFeePoints
  const totalWithdrawalCost = withdrawalPointsValue + withdrawalFeePoints
  const transferNetPoints = Math.max(transferPointsValue - transferFeePoints, 0)
  const trimmedTransferEmail = transferEmail.trim()
  const exchangeFeeLabel = formatFeeLabel(exchangeFeeConfig)
  const transferFeeLabel = formatFeeLabel(transferFeeConfig)
  const withdrawalFeeLabel = formatFeeLabel(withdrawalFeeConfig)
  const convertedExchangeValue = exchangePointsValue * pointsConversionRates[exchangeCurrency]
  const formattedConvertedExchangeValue = new Intl.NumberFormat('fr-FR', {
    style: 'currency',
    currency: exchangeCurrency,
  }).format(Number.isFinite(convertedExchangeValue) ? convertedExchangeValue : 0)
  const remainingPointsAfterExchange = Math.max(userPoints - totalExchangeCost, 0)
  const remainingPointsAfterTransfer = Math.max(userPoints - totalTransferCost, 0)
  const remainingPointsAfterWithdrawal = Math.max(userPoints - totalWithdrawalCost, 0)
  const canConfirmExchange = exchangePointsValue > 0 && totalExchangeCost <= userPoints
  const canConfirmTransfer = transferPointsValue > 0 && Boolean(trimmedTransferEmail) && totalTransferCost <= userPoints
  const withdrawalDetailsValid =
    selectedWithdrawalMethod === 'mobile-money'
      ? withdrawalMobileNumber.trim().length >= 8
      : selectedWithdrawalMethod === 'paypal'
        ? /\S+@\S+\.\S+/.test(withdrawalPaypalEmail.trim())
        : false
  const canConfirmWithdrawal =
    withdrawalPointsValue > 0 &&
    withdrawalPointsValue >= minWithdrawalPoints &&
    (maxWithdrawalPoints <= 0 || withdrawalPointsValue <= maxWithdrawalPoints) &&
    totalWithdrawalCost <= userPoints &&
    selectedWithdrawalMethod !== null &&
    withdrawalDetailsValid
  const withdrawalGrossValue = withdrawalPointsValue * withdrawalValue
  const withdrawalNetPoints = Math.max(withdrawalPointsValue - withdrawalFeePoints, 0)
  const withdrawalNetValue = withdrawalNetPoints * withdrawalValue
  const withdrawalFeeValue = withdrawalFeePoints * withdrawalValue
  const maxAllowedWithdrawal = maxWithdrawalPoints > 0 ? Math.min(maxWithdrawalPoints, userPoints) : userPoints
  const maxAllowedTransfer = Math.max(userPoints - transferFeePoints, 0)

  const withdrawalMethodOptions = [
    {
      id: 'mobile-money' as const,
      label: 'Mobile Money',
      description: 'Transfert instantanÃ© vers votre portefeuille mobile',
      icon: Smartphone,
      accentClass: 'bg-orange-500'
    },
    {
      id: 'paypal' as const,
      label: 'PayPal',
      description: 'Virement sÃ©curisÃ© sur votre compte PayPal',
      icon: Wallet,
      accentClass: 'bg-blue-500'
    }
  ]

  const withdrawalQuickOptions = [
    { id: 'min', label: 'Minimum', value: minWithdrawalPoints },
    { id: '1k', label: '1 000 pts', value: 1000 },
    { id: '5k', label: '5 000 pts', value: 5000 },
    { id: '10k', label: '10 000 pts', value: 10000 },
  ]

  const transferQuickOptions = [
    { id: '500', label: '500 pts', value: 500 },
    { id: '1000', label: '1 000 pts', value: 1000 },
    { id: '2000', label: '2 000 pts', value: 2000 },
    { id: '5000', label: '5 000 pts', value: 5000 },
  ]

  const pointsPurchaseOptions = [
    { id: '1', points: 1000, price: 6000, bonus: 0 },
    { id: '2', points: 2500, price: 14000, bonus: 200 },
    { id: '3', points: 5000, price: 27000, bonus: 600 },
    { id: '4', points: 10000, price: 52000, bonus: 1500 },
  ]

  const [wishlistItems, setWishlistItems] = useState(0)
  const [chatInput, setChatInput] = useState('')
  const [isTyping, setIsTyping] = useState(false)
