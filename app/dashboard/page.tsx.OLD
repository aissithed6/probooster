  // Styles CSS pour les animations
  useEffect(() => {
    // Ajouter les styles CSS pour les animations
    const style = document.createElement('style')
    style.textContent = [
      '@keyframes fadeInUp {',
      '  from {',
      '    opacity: 0;',
      '    transform: translateY(30px);',
      '  }',
      '  to {',
      '    opacity: 1;',
      '    transform: translateY(0);',
