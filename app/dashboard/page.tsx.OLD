    country: '',
    address: '',
    avatar: '/placeholder.jpg'
  })
  const [isHydrated, setIsHydrated] = useState(false)
  const [showWithdrawalModal, setShowWithdrawalModal] = useState(false)
  const [showMoneyTransferModal, setShowMoneyTransferModal] = useState(false)
  const [withdrawalAmount, setWithdrawalAmount] = useState('')
  const [selectedWithdrawalMethod, setSelectedWithdrawalMethod] = useState<'mobile-money' | 'paypal' | null>(null)
  const [withdrawalMobileNumber, setWithdrawalMobileNumber] = useState('')
  const [withdrawalPaypalEmail, setWithdrawalPaypalEmail] = useState('')
  const [transferAmount, setTransferAmount] = useState('')
  const [transferEmail, setTransferEmail] = useState('')
  const [transferMessage, setTransferMessage] = useState('')
  const [selectedTransferQuickOption, setSelectedTransferQuickOption] = useState<string | null>(null)
  const [showPointsPurchaseModal, setShowPointsPurchaseModal] = useState(false)
  const [selectedPointsOffer, setSelectedPointsOffer] = useState<{ points: number; price: number; bonus?: number } | null>(null)
  const [dashboardUserRole, setDashboardUserRole] = useState<'client' | 'seller' | 'super_admin'>('client')
  const [sellerRevenue, setSellerRevenue] = useState(0)
  const [sellerPayoutThreshold, setSellerPayoutThreshold] = useState(100000)
  const [pointsWithdrawalThreshold, setPointsWithdrawalThreshold] = useState(5000)
  const [selectedCurrency, setSelectedCurrency] = useState<'xof' | 'usd' | 'eur'>('xof')
  const [isAiRecommendationEnabled, setIsAiRecommendationEnabled] = useState(true)
  const [compareListLength, setCompareListLength] = useState(0)

  // Debug flag (temporaire): court-circuite le rendu pour isoler l'erreur JSX sans toucher au contenu
  const __DEBUG_RENDER_MINIMAL__ = false
  if (__DEBUG_RENDER_MINIMAL__) {
    return (
      <div className="p-6 text-sm text-gray-700">Diagnostic en cours…</div>
    )
  }

  const [showNewMessageModal, setShowNewMessageModal] = useState(false)
  const [newMessageSubject, setNewMessageSubject] = useState('')
  const [newMessageContent, setNewMessageContent] = useState('')
  const [newMessageCategory, setNewMessageCategory] = useState('general')
  const [newMessagePriority, setNewMessagePriority] = useState('medium')
  const [selectedNotificationCategory, setSelectedNotificationCategory] = useState('all')
  const [selectedPromotionType, setSelectedPromotionType] = useState('all')
