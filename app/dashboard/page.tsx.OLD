  // Fonction pour exporter les promotions
  const exportPromotions = () => {
    const csvContent = [
      ['Titre', 'Type', 'Valeur', 'DÃ©but', 'Fin', 'Utilisations', 'Statut', 'PrioritÃ©'],
      ...mockPromotions.map(promotion => [
        promotion.title,
