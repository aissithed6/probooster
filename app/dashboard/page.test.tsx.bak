export default function DashboardPage() {
  const {
    activeTab,
    handleTabChange,
    notifications,
    unreadCount,
    markAsRead,
    markAllAsRead,
    cartItems,
    wishlist,
    isLoading,
    error,
    profile,
    user,
    authLoading,
  } = useDashboard();

  // Si l'utilisateur n'est pas connecté, le hook useDashboard le redirigera
  if (authLoading || !user) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500"></div>
      </div>
    );
  }

  return (
    <DashboardLayout
      activeTab={activeTab}
      onTabChange={handleTabChange}
      notifications={notifications}
      unreadCount={unreadCount}
      markAsRead={markAsRead}
      markAllAsRead={markAllAsRead}
      cartItems={cartItems}
      wishlist={wishlist}
      isLoading={isLoading}
      error={error}
      profile={profile}
      user={user}
    />
  );
}